<%@ page pageEncoding="UTF-8" %>
<%!
private String uiText(Object value) {
    if (value == null) return "";
    return String.valueOf(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;");
}
%>
<%
model.Usuario uiUser = (model.Usuario) session.getAttribute("usuarioLogueado");
String uiSection = String.valueOf(request.getAttribute("uiSection"));
String uiTitle = String.valueOf(request.getAttribute("uiTitle"));
String uiName = uiUser == null || uiUser.getNombres() == null ? "Usuario" : uiUser.getNombres();
String uiInitial = uiName.isEmpty() ? "U" : uiName.substring(0, 1).toUpperCase(java.util.Locale.ROOT);
%>
<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden"><defs><symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol><symbol id="i-building" viewBox="0 0 24 24"><path d="M4 21V5l9-2v18M13 9h7v12M2 21h20M7 8h2M7 12h2M7 16h2M16 12h1M16 16h1"/></symbol><symbol id="i-clipboard" viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="16" rx="2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="m8 13 2 2 5-5M8 18h7"/></symbol><symbol id="i-spark" viewBox="0 0 24 24"><path d="m12 3 2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4L12 3ZM20 3v4M18 5h4"/></symbol><symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 3v17h17M8 16v-5M13 16V7M18 16V4"/></symbol><symbol id="i-file" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6ZM14 3v6h6M8 13h8M8 17h5"/></symbol><symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol><symbol id="i-logout" viewBox="0 0 24 24"><path d="M9 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4M14 8l4 4-4 4M8 12h13"/></symbol><symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h16M14 6l6 6-6 6"/></symbol><symbol id="i-chevron" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></symbol><symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol><symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></symbol><symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol><symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></symbol><symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></symbol><symbol id="i-logo" viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-8M22 19V2"/></symbol></defs></svg>
<a class="skip-link" href="#contenido-principal">Saltar al contenido</a>
<aside class="sdg-sidebar" aria-label="Barra de navegación">
 <a class="sdg-brand" href="InicioServlet" aria-label="Decisión inicio"><span class="brand-mark"><svg class="icon " aria-hidden="true"><use href="#i-logo"/></svg></span><span><span class="brand-name">Decisión</span><span class="brand-sub">Gestión empresarial</span></span></a>
 <p class="nav-caption">Espacio de trabajo</p>
 <nav class="sdg-nav" aria-label="Menú principal"><a href="InicioServlet" class="<%= "inicio".equals(uiSection) ? "active" : "" %>" <%= "inicio".equals(uiSection) ? "aria-current=\"page\"" : "" %>><svg class="icon " aria-hidden="true"><use href="#i-grid"/></svg><span>Resumen general</span></a><a href="EmpresaServlet" class="<%= "empresas".equals(uiSection) ? "active" : "" %>" <%= "empresas".equals(uiSection) ? "aria-current=\"page\"" : "" %>><svg class="icon " aria-hidden="true"><use href="#i-building"/></svg><span>Empresas</span></a><a href="EvaluacionServlet" class="<%= "evaluaciones".equals(uiSection) ? "active" : "" %>" <%= "evaluaciones".equals(uiSection) ? "aria-current=\"page\"" : "" %>><svg class="icon " aria-hidden="true"><use href="#i-clipboard"/></svg><span>Evaluaciones</span></a><a href="AnalisisServlet" class="<%= "analisis".equals(uiSection) ? "active" : "" %>" <%= "analisis".equals(uiSection) ? "aria-current=\"page\"" : "" %>><svg class="icon " aria-hidden="true"><use href="#i-spark"/></svg><span>Análisis empresarial</span></a><a href="ResultadoServlet" class="<%= "resultados".equals(uiSection) ? "active" : "" %>" <%= "resultados".equals(uiSection) ? "aria-current=\"page\"" : "" %>><svg class="icon " aria-hidden="true"><use href="#i-chart"/></svg><span>Resultados</span></a><a href="ReporteServlet" class="<%= "reportes".equals(uiSection) ? "active" : "" %>" <%= "reportes".equals(uiSection) ? "aria-current=\"page\"" : "" %>><svg class="icon " aria-hidden="true"><use href="#i-file"/></svg><span>Reportes</span></a></nav>
 <div class="sidebar-note"><strong>Una visión integral de tu empresa</strong>Evalúa tus áreas de gestión y encuentra oportunidades de mejora.</div>
 <div class="sidebar-bottom"><span class="status-dot"></span>Evaluación empresarial · MYPES</div>
</aside>
<button type="button" class="nav-overlay" aria-label="Cerrar menú"></button>
<header class="sdg-topbar">
 <button type="button" class="mobile-toggle" data-sidebar-toggle aria-label="Abrir menú" aria-expanded="false"><svg class="icon " aria-hidden="true"><use href="#i-menu"/></svg></button>
 <div class="breadcrumb-line"><span>Espacio de trabajo</span><svg class="icon " aria-hidden="true"><use href="#i-chevron"/></svg><strong><%= uiText(uiTitle) %></strong></div>
 <div class="user-area"><span class="user-avatar" aria-hidden="true"><%= uiText(uiInitial) %></span><span class="user-copy"><%= uiText(uiName) %><small><%= uiUser != null && "ADMIN".equals(uiUser.getRol()) ? "Administrador" : "Gestión empresarial" %></small></span><a class="logout-link" href="LogoutServlet" aria-label="Cerrar sesión" title="Cerrar sesión"><svg class="icon " aria-hidden="true"><use href="#i-logout"/></svg></a></div>
</header>
