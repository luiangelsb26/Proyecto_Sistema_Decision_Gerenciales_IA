<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="model.Usuario,model.Evaluacion,java.util.List,java.text.SimpleDateFormat,java.util.Locale" %>
<%
Usuario usuario=(Usuario)session.getAttribute("usuarioLogueado");
if(usuario==null){response.sendRedirect("login.jsp?error=2");return;}
int[] panelCounts=(int[])request.getAttribute("panelCounts");
if(panelCounts==null){response.sendRedirect("InicioServlet");return;}
List<Evaluacion> panelRecent=(List<Evaluacion>)request.getAttribute("panelRecent");
SimpleDateFormat panelDate=new SimpleDateFormat("dd MMM yyyy",new Locale("es","PE"));
request.setAttribute("uiSection","inicio");request.setAttribute("uiTitle","Resumen general");
%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Resumen general · Decisión</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css?v=20261127-1"></head>
<body class="sdg-app" data-section="inicio" data-page="principal">
<%@ include file="WEB-INF/ui/shell.jspf" %>
<main class="container" id="contenido-principal">
 <div class="page-heading"><div><p class="page-eyebrow">Panel de gestión</p><h1>Resumen general</h1><p>Todo lo que necesitas para conocer mejor tu empresa.</p></div><div class="page-heading-actions"><a class="btn btn-outline-secondary" href="ReporteServlet"><svg class="icon " aria-hidden="true"><use href="#i-file"/></svg>Ver reportes</a><a class="btn btn-primary" href="EvaluacionServlet"><svg class="icon " aria-hidden="true"><use href="#i-plus"/></svg>Nueva evaluación</a></div></div>
 <section class="welcome-banner" aria-label="Bienvenida"><div><span class="eyebrow">Un mejor panorama de tu negocio</span><h2>Hola, <%= uiText(usuario.getNombres()) %>.</h2><p>Convierte la información de tu empresa en una visión clara. Evalúa tus áreas de gestión y descubre dónde dar el siguiente paso.</p></div><div class="banner-visual" aria-label="El cuestionario evalúa 6 dimensiones mediante 30 preguntas"><div class="orbit"></div><div class="instrument-pill"><svg class="icon " aria-hidden="true"><use href="#i-chart"/></svg><strong>6</strong>dimensiones</div><div class="instrument-pill"><svg class="icon " aria-hidden="true"><use href="#i-clipboard"/></svg><strong>30</strong>preguntas</div></div></section>
 <section class="metric-grid" aria-label="Resumen de registros">
<article class="metric"><div class="metric-top"><span>Empresas registradas</span><span class="metric-icon"><svg class="icon " aria-hidden="true"><use href="#i-building"/></svg></span></div><div class="metric-number"><%= panelCounts[0] %></div><span class="metric-foot">En tu espacio de trabajo</span></article><article class="metric"><div class="metric-top"><span>Evaluaciones</span><span class="metric-icon"><svg class="icon " aria-hidden="true"><use href="#i-clipboard"/></svg></span></div><div class="metric-number"><%= panelCounts[1] %></div><span class="metric-foot">Registradas hasta hoy</span></article><article class="metric"><div class="metric-top"><span>Por completar</span><span class="metric-icon"><svg class="icon " aria-hidden="true"><use href="#i-clock"/></svg></span></div><div class="metric-number"><%= panelCounts[2] %></div><span class="metric-foot">Evaluaciones pendientes</span></article><article class="metric"><div class="metric-top"><span>Resultados disponibles</span><span class="metric-icon"><svg class="icon " aria-hidden="true"><use href="#i-chart"/></svg></span></div><div class="metric-number"><%= panelCounts[3] %></div><span class="metric-foot">Evaluaciones con puntaje</span></article>
 </section>
 <div class="dashboard-grid"><section class="recent-panel"><div class="section-heading"><h3>Evaluaciones recientes</h3><a href="EvaluacionServlet">Ver todas <svg class="icon " aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
 <% if(panelRecent==null || panelRecent.isEmpty()){ %>
 <div class="empty-workspace"><span class="empty-icon"><svg class="icon " aria-hidden="true"><use href="#i-clipboard"/></svg></span><h4>Tu próxima decisión empieza aquí</h4><p>Aún no hay evaluaciones registradas. Empieza con una empresa y conoce sus oportunidades de mejora.</p><a class="btn btn-outline-primary" href="<%= panelCounts[0]==0 ? "EmpresaServlet" : "EvaluacionServlet" %>"><svg class="icon " aria-hidden="true"><use href="#i-plus"/></svg><%= panelCounts[0]==0 ? "Registrar mi primera empresa" : "Crear una evaluación" %></a></div>
 <% }else{ %>
 <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Empresa</th><th>Fecha</th><th>Estado</th><th><span class="screen-reader-only">Acción</span></th></tr></thead><tbody>
 <% for(Evaluacion e:panelRecent){ boolean pending="PENDIENTE".equals(e.getEstado()); %>
 <tr><td><strong><%= uiText(e.getNombreEmpresa()) %></strong><br><span class="text-muted">Evaluación #<%= e.getIdEvaluacion() %></span></td><td><%= e.getFechaEvaluacion()==null ? "—" : panelDate.format(e.getFechaEvaluacion()) %></td><td><span class="badge <%= pending ? "bg-warning" : "bg-success" %>"><%= pending ? "Pendiente" : uiText(e.getEstado()) %></span></td><td><a class="btn btn-sm btn-outline-primary" href="<%= pending ? "EvaluacionCuestionarioServlet" : "ResultadoServlet" %>?idEvaluacion=<%= e.getIdEvaluacion() %>"><%= pending ? "Continuar" : "Ver resultado" %><svg class="icon " aria-hidden="true"><use href="#i-arrow"/></svg></a></td></tr>
 <% } %></tbody></table></div><% } %>
 </section>
 <aside class="guide-panel"><h3>De la información a la decisión</h3><p>Tres pasos para una evaluación completa.</p><div class="guide-step"><span class="guide-number">1</span><div><strong>Registra tu empresa</strong><p>Organiza sus datos y crea el punto de partida.</p></div></div><div class="guide-step"><span class="guide-number">2</span><div><strong>Evalúa sus áreas de gestión</strong><p>Responde las 30 preguntas del cuestionario.</p></div></div><div class="guide-step"><span class="guide-number">3</span><div><strong>Revisa las oportunidades</strong><p>Consulta puntajes y recomendaciones para orientar tus decisiones.</p></div></div></aside></div>
 <section class="tool-grid" aria-label="Herramientas de gestión"><a class="tool-link" href="EmpresaServlet"><svg class="icon " aria-hidden="true"><use href="#i-building"/></svg><span><strong>Tu cartera de empresas</strong><small>Información organizada en un solo lugar.</small></span><svg class="icon arrow" aria-hidden="true"><use href="#i-arrow"/></svg></a><a class="tool-link" href="AnalisisServlet"><svg class="icon " aria-hidden="true"><use href="#i-spark"/></svg><span><strong>Análisis empresarial</strong><small>Fortalezas y oportunidades de mejora.</small></span><svg class="icon arrow" aria-hidden="true"><use href="#i-arrow"/></svg></a><a class="tool-link" href="ResultadoServlet"><svg class="icon " aria-hidden="true"><use href="#i-chart"/></svg><span><strong>Resultados por dimensión</strong><small>Una visión integral del desempeño.</small></span><svg class="icon arrow" aria-hidden="true"><use href="#i-arrow"/></svg></a></section>
</main><%@ include file="WEB-INF/ui/footer.jspf" %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>